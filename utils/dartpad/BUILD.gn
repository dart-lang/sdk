import("../../build/dart/copy_tree.gni")
import("../../build/dart/dart_action.gni")
import("compile_wasm.gni")

compile_dart2wasm("worker") {
  main_dart = "../../pkg/dartpad_worker/bin/worker.dart"
  output = "$target_gen_dir/worker.wasm"
}

copy("copy_worker_wasm") {
  deps = [ ":worker" ]
  sources = [
    "$target_gen_dir/worker.wasm",
    "$target_gen_dir/worker.wasm.map",
  ]
  outputs = [ "$root_out_dir/dartpad/{{source_file_part}}" ]
}

action("build_worker_js") {
  deps = [ ":worker" ]
  script = "concat_files.py"

  inputs = [
    "../../pkg/dartpad_worker/lib/src/asset/worker.js",
    "$target_gen_dir/worker.mjs",
  ]
  output = "$root_out_dir/dartpad/worker.js"
  outputs = [ output ]

  args = [ "--output=" + rebase_path(output, root_build_dir) ] +
         rebase_path(inputs, root_build_dir)
}

# Action to build the sdk.tar and version.json files
prebuilt_dart_action("build_sdk_tar") {
  script = "../../pkg/dartpad_worker/tool/build_dart_sdk_tar.dart"

  inputs = [
    "../../pkg/dartpad/lib/src/dartpad_config.dart",
    "../../pkg/dartpad/lib/src/version_info.dart",
    "../../pkg/dartpad_worker/lib/src/worker_protocol_version.dart",
  ]

  outputs = [
    "$root_out_dir/dartpad/sdk.tar",
    "$root_out_dir/dartpad/version.json",
  ]

  # This script reads most of the SDK lib directory.
  # We don't list every file in 'inputs' to avoid GN churn,
  # but we depend on the full SDK being created.
  deps = [ "../../sdk:create_sdk" ]

  args = [
    "--output=" + rebase_path("$root_out_dir/dartpad", root_build_dir),
    "--sdk-root=" + rebase_path("$root_out_dir/dart-sdk", root_build_dir),
  ]
}

# Copy sandbox.js to the dartpad layout
copy("copy_sandbox_js") {
  sources = [ "../../pkg/dartpad_worker/lib/src/asset/sandbox.js" ]
  outputs = [ "$root_out_dir/dartpad/sandbox.js" ]
}

# Copy devtools.html to the dartpad layout
copy("copy_devtools_html") {
  sources = [ "../../pkg/dartpad_worker/lib/src/asset/devtools.html" ]
  outputs = [ "$root_out_dir/dartpad/devtools.html" ]
}

# Copy prebuilt DevTools web bundle to the dartpad/devtools layout
copy_tree("copy_devtools") {
  source = "../../third_party/devtools/web"
  dest = "$root_out_dir/dartpad/devtools"
  exclude = "{}"
}

# Copy devtools.js to the dartpad/devtools layout
copy("copy_devtools_js") {
  deps = [ ":copy_devtools" ]
  sources = [ "../../pkg/dartpad_worker/lib/src/asset/devtools.js" ]
  outputs = [ "$root_out_dir/dartpad/devtools/devtools.js" ]
}

copy("copy_dart_sdk_js") {
  deps = [ "../../utils/ddc:ddc_canary_sdk_ddc_module" ]
  sources = [ "$target_gen_dir/../ddc/canary/sdk/ddc/dart_sdk.js" ]
  outputs = [ "$root_out_dir/dartpad/dart_sdk.js" ]
}

copy("copy_dart_sdk_js_map") {
  deps = [ "../../utils/ddc:ddc_canary_sdk_ddc_module" ]
  sources = [ "$target_gen_dir/../ddc/canary/sdk/ddc/dart_sdk.js.map" ]
  outputs = [ "$root_out_dir/dartpad/dart_sdk.js.map" ]
}

action("build_sandbox_runtime") {
  deps = [ "../../utils/ddc:stack_trace_mapper" ]
  script = "concat_files.py"

  dart_out =
      get_label_info("../../utils/ddc:stack_trace_mapper", "root_out_dir")
  inputs = [
    "../../pkg/dev_compiler/lib/js/ddc/ddc_module_loader.js",
    "$dart_out/dev_compiler/build/web/dart_stack_trace_mapper.js",
  ]
  output = "$root_out_dir/dartpad/sandbox_runtime.js"
  outputs = [ output ]

  args = [ "--output=" + rebase_path(output, root_build_dir) ] +
         rebase_path(inputs, root_build_dir)
}

group("dartpad") {
  deps = [
    ":build_sandbox_runtime",
    ":build_sdk_tar",
    ":build_worker_js",
    ":copy_dart_sdk_js",
    ":copy_dart_sdk_js_map",
    ":copy_devtools",
    ":copy_devtools_html",
    ":copy_devtools_js",
    ":copy_sandbox_js",
    ":copy_worker_wasm",
  ]
}
