  DirectCall print(v50)   # RA: R0 <- (R0) temps: [R1, R2, R3, R4, R5, R6, R7, R8, R9, R10, R11, R12, R13, R14, R19, R20, R23, R25, V0, V1, V2, V3, V4, V5, V6, V7, V8, V9, V10, V11, V12, V13, V14, V15, V16, V17, V18, V19, V20, V21, V22, V23, V24, V25, V26, V27, V28, V29, V30] SAFEPT{live: [], objects: []}
  ParallelMove output(param[2] -> R1)
  Branch(v3, true: B28, false: B29)   # RA: (R1)
B28 = TargetBlock() idom:B14
  ParallelMove output(param[0] -> R0)
  v51 = UnboxSimd(v1)   # RA: V0 <- (R0)
