B5 = TargetBlock() idom:B0
  ParallelMove input(UnboxedDoubleConstant(1.0) -> vloc:V0, UnboxedDoubleConstant(2.0) -> vloc:V1, UnboxedDoubleConstant(3.0) -> vloc:V2, UnboxedDoubleConstant(4.0) -> vloc:V3)
  v12 = SimdOp Float32x4 factory(v42, v43, v44, v45)   # RA: V0 <- (V0, V1, V2, V3)
