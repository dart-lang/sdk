--- externalFoo
B0 = EntryBlock()
  v6 = Constant(null)
  v1 = Parameter(#functionTypeParameters)   # RA: R0 <- ()
  v2 = Parameter(a)   # RA: R1 <- ()
  v3 = Parameter(b)   # RA: R2 <- ()
  ParallelMove output(R2 -> vloc:R2, R1 -> vloc:R0, R0 -> vloc:R1)
  ParallelMove spill(R0 -> stack[0], R2 -> stack[1])
  ParallelMove input(NullConstant(null) -> R2, vloc:R1 -> R1)
  v7 = TypeArguments(v6, v1, <externalFoo.T%>)   # RA: R0 <- (R2, R1) temps: [R3, R4, R5, R6, R7, R8, R9, R10, R11, R12, R13, R14, R19, R20, R23, R25, V0, V1, V2, V3, V4, V5, V6, V7, V8, V9, V10, V11, V12, V13, V14, V15, V16, V17, V18, V19, V20, V21, V22, V23, V24, V25, V26, V27, V28, V29, V30] SAFEPT{live: [R1, R2], objects: [R1, R2, stack[0], stack[1]]}
  ParallelMove output(R0 -> vloc:R0, stack[0] -> R1, stack[1] -> R2)
  v10 = ExternalCall externalFoo(v7, v2, v3, v6)   # RA: R0 <- (R0, R1, R2, -) temps: [R1, R2, R3, R4, R5, R6, R7, R8, R9, R10, R11, R12, R13, R14, R19, R20, R23, R25, V0, V1, V2, V3, V4, V5, V6, V7, V8, V9, V10, V11, V12, V13, V14, V15, V16, V17, V18, V19, V20, V21, V22, V23, V24, V25, V26, V27, V28, V29, V30] SAFEPT{live: [], objects: []}
  ParallelMove output(R0 -> vloc:R0)
  ParallelMove input(vloc:R0 -> R0)
  Return(v10)   # RA: (R0)

--- main
B0 = EntryBlock()
  v1 = Constant(null)
  ParallelMove input(NullConstant(null) -> R0)
  Return(v1)   # RA: (R0)

