part 'unordered_constructor_part1.dart';

part 'unordered_constructor_part2.dart';

const annotation1 = 1;

const annotation2 = 2;

class Class1 {
  var field;
  new() {}
  new withInitializers() : field = 0;
  new alias() : this();
  factory fact() {}
  factory redirect() = Class1;
}

class Class2 {
  var field;
  @annotation1
  new();
  @annotation1
  new withInitializers();
  @annotation1
  new alias();
  @annotation1
  factory fact();
  @annotation1
  factory redirect();
}

class Class3 {
  var field;
  @annotation1
  new();
  @annotation1
  new withInitializers();
  @annotation1
  new alias();
  @annotation1
  factory fact();
  @annotation1
  factory redirect();
}

main() {}

expect(expected, actual) {}
